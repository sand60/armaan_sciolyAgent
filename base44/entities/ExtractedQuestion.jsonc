{
  "name": "ExtractedQuestion",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "test_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "sub_topic": {
      "type": "string"
    },
    "question_text": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correct_answer": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "aligned_with_current_rules": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "school_id",
    "event_name",
    "question_text",
    "correct_answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}