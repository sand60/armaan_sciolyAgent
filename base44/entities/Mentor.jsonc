{
  "name": "Mentor",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "mentor_name": {
      "type": "string"
    },
    "mentor_email": {
      "type": "string"
    },
    "whatsapp_phone": {
      "type": "string"
    },
    "child_name": {
      "type": "string"
    },
    "volunteer_type": {
      "type": "string"
    },
    "preferred_events": {
      "type": "string"
    },
    "availability_window": {
      "type": "string"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "Pending",
        "Cleared"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "Not Started"
    },
    "assigned_event": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "mentor_name",
    "mentor_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}