{
  "name": "PracticeLog",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "Quiz",
        "Study Session",
        "Build Test",
        "Lab Drill"
      ],
      "enumColors": [
        "blue",
        "purple",
        "red",
        "green"
      ]
    },
    "quiz_score": {
      "type": "number"
    },
    "quiz_total": {
      "type": "number"
    },
    "device_dimensions_mass": {
      "type": "string"
    },
    "test_result": {
      "type": "string"
    },
    "photo_uri": {
      "type": "string"
    },
    "ai_rule_check": {
      "type": "string",
      "enum": [
        "Pass",
        "Review",
        "Fail",
        "Not checked"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray"
      ],
      "default": "Not checked"
    },
    "ai_rule_note": {
      "type": "string"
    },
    "mentor_verified": {
      "type": "boolean",
      "default": false
    },
    "mentor_notes": {
      "type": "string"
    },
    "flag_reason": {
      "type": "string"
    },
    "missed_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_text": {
            "type": "string"
          },
          "sub_topic": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "school_id",
    "event_name",
    "activity_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}