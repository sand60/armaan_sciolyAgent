{
  "name": "PracticeSession",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "mentor_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "Virtual",
        "In person"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "In person"
    },
    "location": {
      "type": "string",
      "description": "Room or address for in-person practices"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Cancelled"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "Scheduled"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "event_name",
    "mentor_name",
    "start_time",
    "session_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}"
    }
  }
}