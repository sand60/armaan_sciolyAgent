{
  "name": "TeamLicense",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "team_name": {
      "type": "string"
    },
    "division": {
      "type": "string",
      "enum": [
        "Division B",
        "Division C"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "Monthly",
        "Season"
      ],
      "enumColors": [
        "blue",
        "green"
      ]
    },
    "amount": {
      "type": "number",
      "description": "Price charged for this one team license, in dollars"
    },
    "expected_total": {
      "type": "number",
      "description": "Total for the whole order in cents, persisted before checkout"
    },
    "checkout_session_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "ordered_by_id": {
      "type": "string",
      "description": "User id that started the checkout"
    },
    "status": {
      "type": "string",
      "enum": [
        "Awaiting payment",
        "Active",
        "Disabled",
        "Cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray",
        "red"
      ],
      "default": "Awaiting payment"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Paid",
        "Refunded",
        "Failed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray",
        "red"
      ],
      "default": "Pending"
    },
    "coach_name": {
      "type": "string"
    },
    "coach_email": {
      "type": "string",
      "format": "email"
    },
    "coach_phone": {
      "type": "string"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "season_end_date": {
      "type": "string",
      "format": "date"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "school_name",
    "division",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}